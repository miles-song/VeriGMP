+    ensures final(dst)@.len()==old(dst)@.len(),final(scratch)@.len()==old(scratch)@.len(),
+        value(final(dst)@)==(value(a@)*value(a@))%modulus(a@.len(),top as nat),
+        0<=value(final(dst)@)<modulus(a@.len(),top as nat),
