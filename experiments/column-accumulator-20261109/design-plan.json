  "static_analysis": {
    "type": "analytic source-level recurrence expansion, not execution/proof/profile",
    "recurrence": {
      "karatsuba": "K(n)=2*K(ceil(n/2))+K(floor(n/2)); n<=24 uses leaf",
      "toom3": "T(n)=T(ceil(n/3))+T(n-2*ceil(n/3))+3*T(ceil(n/3)+1); n<=192 uses K",
      "mul_low": "M(n-h)+2*L(h), with actual threshold/low_limit and h=floor(11*n/36) or floor(9*n/40)",
      "square_low": "S(n-h)+one general low product(h), with square limits and h=floor(11*n/36)"
    },
    "cost_model": {
      "full_row_products": "n*n",
      "full_row_dst_reads": "n*(n-1)",
      "full_row_dst_writes": "n*n+n",
      "low_row_products": "n*(n+1)/2",
      "low_row_dst_reads": "n*(n-1)/2",
      "low_row_dst_writes": "n*(n+1)/2",
      "full_column_dst_writes": "2*n",
      "low_column_dst_writes": "n",
      "full_square_products": "n*(n+1)/2 for n>=8",
      "low_square_products": "(n*(n+1)/2 + ceil(n/2))/2 for n>=9",
      "exclusions": [
        "evaluation/interpolation word multiplications",
        "recursion recombination traffic",
        "square-leaf traffic in dst metrics",
        "compiler spills",
        "cache misses",
        "cycle timings"
      ],
      "column_traffic_scope": "hypothetical replacement of all general multiplication leaves; actual first implementation is bounded to declared full/low scopes",
      "input_load_caveat": "column scanning may load more a-operand words, so removed dst loads are not net total-load savings"
    },
